{#
    Shared filter bar for the dashboard and the reports list.
    Expects `bar` (FilterBarFactory::create) and `switch_route` (the other page, which keeps the same filter).
#}
{% set q = bar.query %}
{% set select_class = 'w-full' %}
<form method="get" action="{{ path(app.request.attributes.get('_route'), {_locale: app.request.locale}) }}"
      class="card mb-8"
      data-controller="filter"
      data-action="change->filter#apply submit->filter#clean"
      role="search" aria-label="{{ 'filter.label'|trans }}">
    <div class="grid gap-3 sm:grid-cols-2 {{ bar.countries|length > 1 ? 'lg:grid-cols-6' : 'lg:grid-cols-5' }}">
        {% if bar.countries|length > 1 %}
            <label class="space-y-1 text-sm">
                <span class="font-medium">{{ 'filter.incident_country'|trans }}</span>
                <select name="country" class="{{ select_class }}">
                    <option value="">{{ 'filter.all_countries'|trans }}</option>
                    {% for code in bar.countries %}
                        <option value="{{ code }}" {{ q.country and q.country.code == code ? 'selected' }}>{{ code|country_name }}</option>
                    {% endfor %}
                </select>
            </label>
        {% endif %}
        <label class="space-y-1 text-sm">
            <span class="font-medium">{{ 'filter.make'|trans }}</span>
            <select name="make" class="{{ select_class }}" data-filter-target="make">
                <option value="">{{ 'filter.all_makes'|trans }}</option>
                {% for make, count in bar.makes %}
                    <option value="{{ make }}" {{ q.make == make ? 'selected' }}>{{ make }} ({{ count }})</option>
                {% endfor %}
                {% if q.make and q.make not in bar.makes|keys %}
                    <option value="{{ q.make }}" selected>{{ q.make }} (0)</option>
                {% endif %}
            </select>
        </label>
        <label class="space-y-1 text-sm">
            <span class="font-medium">{{ 'filter.model'|trans }}</span>
            <select name="model" class="{{ select_class }} disabled:opacity-50" data-filter-target="model" {{ q.make ? '' : 'disabled' }}>
                <option value="">{{ q.make ? 'filter.all_models'|trans : 'filter.pick_make_first'|trans }}</option>
                {% for model, count in bar.models %}
                    <option value="{{ model }}" {{ q.model == model ? 'selected' }}>{{ model }} ({{ count }})</option>
                {% endfor %}
            </select>
        </label>
        <label class="space-y-1 text-sm">
            <span class="font-medium">{{ 'filter.road_type'|trans }}</span>
            <select name="road_type" class="{{ select_class }}">
                <option value="">{{ 'filter.all_roads'|trans }}</option>
                {% for r in bar.roadTypes %}
                    <option value="{{ r.value }}" {{ q.roadType == r ? 'selected' }}>{{ r.translationKey|trans }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="space-y-1 text-sm">
            <span class="font-medium">{{ 'filter.period'|trans }}</span>
            <select name="period" class="{{ select_class }}" data-filter-target="period">
                {% for p in bar.periods %}
                    <option value="{{ p.value }}" {{ q.period == p ? 'selected' }}>{{ p.translationKey|trans }}</option>
                {% endfor %}
            </select>
        </label>
        <div class="grid grid-cols-2 gap-2 text-sm" data-filter-target="custom" {{ q.period.value == 'custom' ? '' : 'hidden' }}>
            <label class="space-y-1">
                <span class="font-medium">{{ 'filter.from'|trans }}</span>
                <input type="date" name="from" value="{{ q.from ? q.from|date('Y-m-d') }}" max="{{ 'now'|date('Y-m-d') }}" class="block w-full rounded-lg border border-stone-300 bg-white px-2 py-2 text-sm dark:border-stone-700 dark:bg-stone-900">
            </label>
            <label class="space-y-1">
                <span class="font-medium">{{ 'filter.to'|trans }}</span>
                <input type="date" name="to" value="{{ q.to ? q.to|date('Y-m-d') }}" max="{{ 'now'|date('Y-m-d') }}" class="block w-full rounded-lg border border-stone-300 bg-white px-2 py-2 text-sm dark:border-stone-700 dark:bg-stone-900">
            </label>
        </div>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <noscript><button type="submit" class="btn-secondary">{{ 'filter.apply'|trans }}</button></noscript>
        {% if q.active %}
            <a href="{{ path(app.request.attributes.get('_route')) }}" class="text-stone-500 underline hover:text-stone-800 dark:hover:text-stone-200">{{ 'filter.reset'|trans }}</a>
        {% endif %}
        <a href="{{ path(switch_route, q.toQuery) }}" class="ml-auto font-medium text-brand-600 hover:underline">
            {{ (switch_route == 'incident_list' ? 'filter.to_list' : 'filter.to_stats')|trans }} →
        </a>
    </div>
</form>
