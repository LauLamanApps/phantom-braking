{% macro tile(value, label, hint = null) %}
    <div class="card">
        <div class="stat-value">{{ value }}</div>
        <div class="stat-label">{{ label }}</div>
        {% if hint %}<div class="mt-2 text-xs text-stone-500 dark:text-stone-500">{{ hint }}</div>{% endif %}
    </div>
{% endmacro %}

{% macro pct(value) %}{{ value is null ? '–' : value|format_number({fraction_digit: 0}) ~ '%' }}{% endmacro %}

{# Chart card with an accessible table view of the same numbers. #}
{% macro chart_card(title, chart, counts, prefix = null, subtitle = null, tall = false) %}
    <section class="card">
        <h3 class="font-semibold">{{ title }}</h3>
        {% if subtitle %}<p class="mt-0.5 text-sm text-stone-500 dark:text-stone-400">{{ subtitle }}</p>{% endif %}
        {% if counts|length == 0 or max(counts|merge([0])) == 0 %}
            <p class="mt-6 text-sm text-stone-500">{{ 'stats.no_data'|trans }}</p>
        {% else %}
            <div class="chart-box mt-4 {{ tall ? 'h-96' : '' }}">{{ render_chart(chart) }}</div>
            <details class="mt-3 text-sm">
                <summary class="cursor-pointer text-stone-500 hover:text-stone-800 dark:hover:text-stone-200">{{ 'stats.show_table'|trans }}</summary>
                <table class="mt-2 w-full">
                    <tbody>
                    {% for key, count in counts %}
                        <tr class="border-t border-stone-100 dark:border-stone-800">
                            <td class="py-1">{{ prefix ? (prefix ~ key)|trans : key }}</td>
                            <td class="py-1 text-right tabular-nums">{{ count }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </details>
        {% endif %}
    </section>
{% endmacro %}
