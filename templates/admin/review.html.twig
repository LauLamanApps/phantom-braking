{% extends 'admin/base.html.twig' %}

{% macro status(status) %}
    {% set colours = {pending: 'bg-yellow-100 text-yellow-900', approved: 'bg-emerald-100 text-emerald-900', rejected: 'bg-stone-200 text-stone-700', withdrawn: 'bg-stone-200 text-stone-700'} %}
    <span class="rounded-full px-2 py-0.5 text-xs font-semibold {{ colours[status.value] ?? '' }}">{{ status.translationKey|trans }}</span>
{% endmacro %}

{% macro decide(route, params, decision, label, primary = false) %}
    <form method="post" action="{{ path(route, params|merge({decision: decision})) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
        <button class="{{ primary ? 'btn-primary' : 'btn-secondary' }}">{{ label }}</button>
    </form>
{% endmacro %}

{% block title %}{{ incident.vehicle.make }} {{ incident.vehicle.model }}{% endblock %}

{% block body %}
    {% import _self as m %}
    <a href="{{ path('admin_dashboard') }}" class="text-sm text-stone-500 hover:underline">← {{ 'admin.title'|trans }}</a>
    <div class="mt-2 flex flex-wrap items-baseline justify-between gap-4">
        {{ include('admin/_incident_line.html.twig') }}
        <a href="{{ path('incident_show', {id: incident.id, _locale: app.request.locale}) }}" class="text-sm text-brand-600 hover:underline" target="_blank">{{ 'admin.public_page'|trans }} ↗</a>
    </div>

    {% if incident.mediaDeletionRequestedAt %}
        <p class="mt-4 rounded-lg bg-brand-50 p-3 text-sm text-brand-700">{{ 'admin.review.deletion_pending'|trans }}</p>
    {% endif %}

    {% if incident.footage.exists %}
        <section class="card mt-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="font-semibold">{{ 'incident.footage'|trans }} {{ m.status(incident.footage.status) }}</h2>
                <div class="flex gap-2">
                    {{ m.decide('admin_moderate_footage', {id: incident.id}, 'reject', 'admin.reject'|trans) }}
                    {% if incident.footage.publicationConsent %}{{ m.decide('admin_moderate_footage', {id: incident.id}, 'approve', 'admin.approve'|trans, true) }}{% endif %}
                </div>
            </div>
            <p class="mt-2 rounded-lg bg-yellow-50 p-2 text-sm text-yellow-900 dark:bg-yellow-900/30 dark:text-yellow-100">{{ 'admin.review.footage_rule'|trans }}</p>
            <video class="mt-3 w-full rounded-xl bg-black" controls preload="metadata" src="{{ path('admin_media', {kind: 'footage', id: incident.id}) }}"></video>
        </section>
    {% endif %}

    {% for photo in incident.photos %}
        <section class="card mt-6" id="photo-{{ photo.id }}">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="font-semibold">{{ 'admin.review.photo'|trans({n: loop.index}) }} {{ m.status(photo.status) }}</h2>
                <div class="flex gap-2">
                    {{ m.decide('admin_moderate_photo', {id: photo.id}, 'reject', 'admin.reject'|trans) }}
                    {% if photo.publicationConsent and photo.publishedPath %}{{ m.decide('admin_moderate_photo', {id: photo.id}, 'approve', 'admin.approve'|trans, true) }}{% endif %}
                </div>
            </div>
            <p class="mt-2 text-sm text-stone-500">{{ 'admin.review.mask_help'|trans }}</p>

            {# The editor shows the private original with the current masks on top; saving regenerates the public copy. #}
            <form method="post" action="{{ path('admin_save_photo_masks', {id: photo.id}) }}" class="mt-3"
                  data-controller="plate-mask"
                  data-plate-mask-masks-value="{{ photo.masks|map(mask => mask.toArray)|json_encode }}"
                  data-plate-mask-remove-label-value="{{ 'report.photos.mask_remove'|trans }}">
                <div class="relative cursor-crosshair touch-none select-none overflow-hidden rounded-lg" data-plate-mask-target="layer">
                    <img src="{{ path('admin_media', {kind: 'photo-original', id: photo.id}) }}" alt="" draggable="false" class="block w-full" data-plate-mask-target="image">
                </div>
                <input type="hidden" name="masks" data-plate-mask-target="input">
                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                <div class="mt-3 flex flex-wrap items-center gap-3">
                    <button type="submit" class="btn-primary">{{ 'admin.review.save_masks'|trans }}</button>
                    <button type="button" class="text-sm text-stone-500 underline" data-action="plate-mask#clear">{{ 'admin.review.clear_masks'|trans }}</button>
                    {% if photo.publishedPath %}
                        <a href="{{ path('admin_media', {kind: 'photo-masked', id: photo.id}) }}" target="_blank" class="ml-auto text-sm text-brand-600 hover:underline">{{ 'admin.review.view_public'|trans }} ↗</a>
                    {% endif %}
                </div>
            </form>
        </section>
    {% endfor %}

    {% if not incident.hasMedia %}
        <p class="card mt-6 text-sm text-stone-500">{{ 'admin.review.no_media'|trans }}</p>
    {% endif %}
{% endblock %}
