# Production settings. provision.sh copies this to /var/www/phantombraking.eu/shared/.env.local
# (readable by deployer and www-data only) and fills in the generated values. Never commit the real file.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=__GENERATED__

# Public URL: also the passkey (WebAuthn) relying party. Changing the domain means every admin adds a new passkey.
DEFAULT_URI=https://phantombraking.eu

# IP of the existing reverse proxy, so the visitor's IP (rate limits) and HTTPS are detected correctly.
TRUSTED_PROXIES=REVERSE_PROXY_IP

DATABASE_URL="postgresql://phantom_braking:__DB_PASSWORD__@127.0.0.1:5432/phantom_braking?serverVersion=17&charset=utf8"

# Secret key for the plate fingerprints. Generated once; NEVER change it afterwards (all repeat counts would break)
# and never reuse the dev value: anyone who knows it can brute-force a plate from a fingerprint.
PLATE_FINGERPRINT_KEY=__GENERATED__

# Optional app token from opendata.rdw.nl (higher rate limit).
RDW_APP_TOKEN=

# Object storage for photos and videos (two private buckets).
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=eu-central-1
MEDIA_S3_PHOTO_BUCKET=phantom-braking-photos
MEDIA_S3_VIDEO_BUCKET=phantom-braking-videos
# Sliplane issues credentials per bucket; the endpoint is shared.
MEDIA_S3_PHOTO_ACCESS_KEY=
MEDIA_S3_PHOTO_SECRET_KEY=
MEDIA_S3_VIDEO_ACCESS_KEY=
MEDIA_S3_VIDEO_SECRET_KEY=
MEDIA_S3_PATH_STYLE=true

SENTRY_DSN=

# The data controller, shown in the privacy statement and terms.
OPERATOR_NAME=
OPERATOR_EMAIL=
OPERATOR_ADDRESS=
