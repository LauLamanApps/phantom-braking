###> symfony/framework-bundle ###
APP_HOSTNAME=phantom-braking.dev
# Traefik → nginx → php-fpm: trust the docker network so getClientIp() (rate limiting) sees the real client.
TRUSTED_PROXIES=private_ranges
DEFAULT_URI=https://phantom-braking.dev
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://phantom:pass@postgres:5432/phantom-braking?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> app/media-storage ###
# RustFS in .dev/docker-compose.yml (dev-only credentials)
MEDIA_S3_ENDPOINT=http://rustfs:9000
MEDIA_S3_PHOTO_ACCESS_KEY=phantom-dev
MEDIA_S3_PHOTO_SECRET_KEY=phantom-dev-secret
MEDIA_S3_VIDEO_ACCESS_KEY=phantom-dev
MEDIA_S3_VIDEO_SECRET_KEY=phantom-dev-secret
###< app/media-storage ###
